# Local cluster setup reads this key and puts it into a Kubernetes Secret.
# Keep the real .env ignored. No key is sent to browser code.
OPENAI_API_KEY=
# Configure the deployed model through Helm chat.model (default gpt-6-luna).

# Optional standalone SQLite gateway development slice (no dashboard/session API).
# Cluster applications instead use DATABASE_URL_FILE and projected Secrets.
API_KEY_PEPPER_FILE=.data/api-key-pepper
GATEWAY_DATABASE=.data/gateway.sqlite
GATEWAY_PORT=3000
WOO_MCP_URL=http://127.0.0.1:3001/mcp
WOO_MCP_TOKEN_FILE=.data/woo-mcp-token
WOO_MCP_PORT=3001
STORE_PUBLIC_URL=http://store.storelink.localhost
STORE_CONNECT_SERVICE=storelink-wordpress
# Only for a standalone adapter: paths to files containing a WooCommerce REST
# consumer key and secret. Leave these blank for the Kubernetes setup; its
# bootstrap generates the credentials and mounts /secrets/woo-consumer-*.
WOO_CONSUMER_KEY_FILE=
WOO_CONSUMER_SECRET_FILE=
