{
  "name": "storelink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test --test-isolation=none tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bootstrap:dev": "node scripts/bootstrap-dev.ts",
    "start:gateway": "node --env-file-if-exists=.env services/gateway/src/main.ts",
    "start:woocommerce-mcp": "node --env-file-if-exists=.env services/woocommerce-mcp/src/main.ts",
    "build:dashboard": "vite build --config apps/dashboard/vite.config.ts apps/dashboard",
    "dev:dashboard": "vite --config apps/dashboard/vite.config.ts apps/dashboard"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/sdk": "1.28.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.2.1",
    "undici": "7.30.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.11.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@modelcontextprotocol/inspector@2.11.0": true
  }
}
